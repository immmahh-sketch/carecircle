[Unit]
Description=HomeHub smart home hub
After=network-online.target
Wants=network-online.target

[Service]
User=homehub
WorkingDirectory=@APP_DIR@
Environment=HOMEHUB_DATA=/var/lib/homehub
Environment=PORT=8787
ExecStart=@NODE@ src/server.js
Restart=always
RestartSec=5
# Hardening: it only needs to read its code and write its data directory
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/homehub
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
